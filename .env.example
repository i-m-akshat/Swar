# ==============================================================================
# Vocalis Environment Configuration Template
# Copy this file to .env and configure for your local/production environment
# ==============================================================================

# Fastify Server
PORT=3000
NODE_ENV=production

# PostgreSQL + pgvector
DATABASE_URL=postgresql://postgres:postgres@db:5432/vad_db

# Redis Message Broker (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# CUDA Device Config (0 for single GPU)
CUDA_VISIBLE_DEVICES=0

# HuggingFace / Model Cache Directory
HF_HOME=/root/.cache/huggingface
